<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The extensibility bet: one library that already owns the numerics coming next — weighted
         fits against σ(x), multiple regression, filtering — so each becomes a call rather than an
         implementation. Pure managed, so it runs on the wasm head unchanged. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

</Project>
