<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             x:Class="Terrafa.Continuum.Frontend.Controls.TerminalTopBar"
             x:Name="Root"
             Height="36">
  <Border Background="{StaticResource BgBarBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
    <DockPanel Margin="14,0">
      <controls:SquircleBorder x:Name="SettingsButton" Classes="emboss" DockPanel.Dock="Right"
                               Margin="14,0,0,0" Padding="10,5"
                               Background="{StaticResource EmbossSurfaceBrush}"
                               VerticalAlignment="Center" Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:SpurGearIcon Fill="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" />
          <TextBlock Text="SETTINGS" FontSize="{DynamicResource FontSize9}" LetterSpacing="1"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSubBrush}" />
        </StackPanel>
      </controls:SquircleBorder>
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                 Text="READ ONLY · SETTINGS ▸ BUILDER MODE TO MAKE CHANGES"
                 FontSize="{DynamicResource FontSize9}" LetterSpacing="1"
                 Foreground="{DynamicResource TextMutedBrush}"
                 IsVisible="{DynamicResource BuilderHintVisible}" />
      <ContentControl DockPanel.Dock="Right"
                      VerticalAlignment="Center"
                      Content="{Binding RightContent, ElementName=Root}" />
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock x:Name="BrandButton" Classes="engraved" Text="TERRAFA" FontSize="{DynamicResource FontSize12}" FontWeight="Bold"
                   LetterSpacing="2" Cursor="Hand" />
        <TextBlock Text="CONTINUUM CORE" FontSize="{DynamicResource FontSize12}" LetterSpacing="1"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock Text="│" FontSize="{DynamicResource FontSize12}" Foreground="{StaticResource TextGhostBrush}" />
        <TextBlock Text="{Binding CommandText, ElementName=Root}" FontSize="{DynamicResource FontSize12}"
                   Foreground="{StaticResource AmberBrush}" />
        <TextBlock Text="{Binding SubtitleText, ElementName=Root}" FontSize="{DynamicResource FontSize12}"
                   Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
