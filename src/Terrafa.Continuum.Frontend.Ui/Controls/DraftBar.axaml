<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             x:Class="Terrafa.Continuum.Frontend.Controls.DraftBar"
             x:Name="Root"
             Height="54">
  <UserControl.Styles>
    <Style Selector="Rectangle.cursorBlink">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="49%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Border Background="{StaticResource BgBarBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0">
    <DockPanel Margin="14,0" VerticalAlignment="Center">
      <TextBlock Text="DRAFT ▸" FontSize="{DynamicResource FontSize12}" LetterSpacing="1"
                 Foreground="{StaticResource AmberBrush}"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12"
                  VerticalAlignment="Center" Margin="12,0,0,0">
        <ContentControl Content="{Binding ChipContent, ElementName=Root}" VerticalAlignment="Center" />
        <controls:SquircleBorder Classes="emboss-key" Background="{StaticResource AmberBrush}"
                                 Padding="14,6">
          <TextBlock Text="{Binding CommitText, ElementName=Root}" FontSize="{DynamicResource FontSize11}"
                     FontWeight="Bold" Foreground="Black" />
        </controls:SquircleBorder>
      </StackPanel>
      <Border Background="{StaticResource BgDeepBrush}"
              BorderBrush="{StaticResource BorderMidBrush}"
              BorderThickness="1" Padding="10,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding CommandText, ElementName=Root}" FontSize="{DynamicResource FontSize12}"
                     Foreground="{StaticResource TextBrightBrush}"
                     TextTrimming="CharacterEllipsis" />
          <Rectangle Classes="cursorBlink" Width="8" Height="14" Margin="3,0,0,0"
                     Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                     IsVisible="{Binding ShowCursor, ElementName=Root}" />
        </StackPanel>
      </Border>
    </DockPanel>
  </Border>
</UserControl>
