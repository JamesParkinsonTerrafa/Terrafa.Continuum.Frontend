<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:diagram="using:Terrafa.Continuum.Frontend.Controls.Diagram"
             x:Class="Terrafa.Continuum.Frontend.Views.NetworkView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <Panel>
  <DockPanel>
    <controls:TerminalTopBar DockPanel.Dock="Top"
                             CommandText="NETW"
                             SubtitleText="MODEL NETWORK" />

    <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="0">
      <controls:TerminalTabStrip.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="AS-OF" FontSize="{DynamicResource FontSize11}" Foreground="{StaticResource TextMutedBrush}"
                     VerticalAlignment="Center" />
          <Border Background="{StaticResource BgFieldBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,3">
            <TextBlock x:Name="AsOfText" FontSize="{DynamicResource FontSize11}" Foreground="{StaticResource TextBrush}" />
          </Border>
          <TextBlock Text="filtration 𝓕ₜ — values shown use events ≤ t only" FontSize="{DynamicResource FontSize11}"
                     Foreground="{StaticResource TextFaintBrush}" Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     IsVisible="{DynamicResource HintsVisible}" />
        </StackPanel>
      </controls:TerminalTabStrip.RightContent>
    </controls:TerminalTabStrip>

    <controls:TerminalStatusBar DockPanel.Dock="Bottom">
      <controls:TerminalStatusBar.LeftContent>
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock x:Name="EventCountText" FontSize="{DynamicResource FontSize10}" Foreground="{StaticResource TextFaintBrush}" />
          <TextBlock x:Name="FigureCountText" FontSize="{DynamicResource FontSize10}" Foreground="{StaticResource TextFaintBrush}" />
          <TextBlock Text="STATE = FOLD(LOG) · REPLAY ✓" FontSize="{DynamicResource FontSize10}" Foreground="{StaticResource TextFaintBrush}"
                     IsVisible="{DynamicResource HintsVisible}" />
        </StackPanel>
      </controls:TerminalStatusBar.LeftContent>
      <controls:TerminalStatusBar.RightContent>
        <TextBlock Text="σ PROPAGATION: JACOBIAN · MC FALLBACK ARMED" FontSize="{DynamicResource FontSize10}"
                   Foreground="{StaticResource TextFaintBrush}"
                   IsVisible="{DynamicResource HintsVisible}" />
      </controls:TerminalStatusBar.RightContent>
    </controls:TerminalStatusBar>

    <controls:DraftBar DockPanel.Dock="Bottom"
                       CommandText="MAP (tank_01.level, tank_02.level) -&gt; fig.total_inventory AS sum"
                       ShowCursor="True">
      <controls:DraftBar.ChipContent>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <controls:Chip Text="PARSE ✓" Accent="green" />
          <controls:Chip Text="ν ≪ µ ✓" Accent="green" />
          <controls:Chip Text="C¹ ✓ linear" Accent="green" />
          <controls:Chip Text="σ_out 152 bbl" Accent="cyan" />
        </StackPanel>
      </controls:DraftBar.ChipContent>
    </controls:DraftBar>

    <Border DockPanel.Dock="Left" Width="272"
            IsVisible="{DynamicResource BuilderPanelsVisible}"
            Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <controls:PanelBox Title="NETWORK ELEMENTS" FooterHeight="54">
        <controls:PanelBox.InnerContent>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10" Spacing="4">
              <StackPanel x:Name="BuildList" Spacing="4" />
              <StackPanel x:Name="MeasureList" Spacing="4" />
            </StackPanel>
          </ScrollViewer>
        </controls:PanelBox.InnerContent>
        <controls:PanelBox.FooterContent>
          <TextBlock Text="Only selected leaves enter the network. Selecting a leaf enlarges 𝒢 — every estimate it feeds sharpens."
                     FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                     MaxLines="3" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource TextFaintBrush}"
                     IsVisible="{DynamicResource HintsVisible}" />
        </controls:PanelBox.FooterContent>
      </controls:PanelBox>
    </Border>

    <Panel>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="70%" RadiusY="70%">
            <GradientStop Color="{StaticResource CanvasGlowInnerColor}" Offset="0" />
            <GradientStop Color="{StaticResource CanvasGlowOuterColor}" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <diagram:DiagramCanvas x:Name="Diagram" />

      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"
              Background="{StaticResource CanvasPanelBackdropBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              Padding="12,8" IsHitTestVisible="False">
        <StackPanel Spacing="5" x:Name="LegendPanel" />
      </Border>
    </Panel>
  </DockPanel>
  <Canvas x:Name="GhostLayer" IsHitTestVisible="False" />
  <controls:HintPointerLayer ScreenIndex="0" />
  <controls:TourLayer ScreenIndex="0" />
  <controls:OverlayDialog x:Name="Dialog" />
  </Panel>
</UserControl>
