<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:dashboard="using:Terrafa.Continuum.Frontend.Controls.Dashboard"
             x:Class="Terrafa.Continuum.Frontend.Views.DashboardView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <Panel>
    <DockPanel>
      <controls:TerminalTopBar DockPanel.Dock="Top"
                               CommandText="DASH"
                               SubtitleText="LIVE STATE" />

      <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="2"
                                 HintText="drag a tile onto the canvas · double-click a tile to wire it · drag the background to pan · scroll to zoom · tiles snap to the grid on release" />

      <controls:TerminalStatusBar DockPanel.Dock="Bottom">
        <controls:TerminalStatusBar.LeftContent>
          <StackPanel Orientation="Horizontal" Spacing="18"
                      IsVisible="{DynamicResource HintsVisible}">
            <TextBlock Text="FREE-PLACEMENT TILE CANVAS" FontSize="{DynamicResource FontSize10}"
                       Foreground="{StaticResource TextFaintBrush}" />
            <TextBlock Text="EVERY CHART FORM CARRIES ITS BOUNDS" FontSize="{DynamicResource FontSize10}"
                       Foreground="{StaticResource TextFaintBrush}" />
          </StackPanel>
        </controls:TerminalStatusBar.LeftContent>
        <controls:TerminalStatusBar.RightContent>
          <TextBlock x:Name="StatusRight" FontSize="{DynamicResource FontSize10}"
                     Foreground="{StaticResource TextFaintBrush}" />
        </controls:TerminalStatusBar.RightContent>
      </controls:TerminalStatusBar>

      <Border x:Name="ElementsPanel" DockPanel.Dock="Left" Width="238"
              IsVisible="{DynamicResource BuilderPanelsVisible}"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:PanelBox Title="DASHBOARD ELEMENTS" FooterHeight="54">
          <controls:PanelBox.InnerContent>
            <ScrollViewer>
              <StackPanel x:Name="ElementsList" Margin="12,10" Spacing="4" />
            </ScrollViewer>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock Text="Drag an element onto the canvas. It lands empty — double-click it to wire its sources."
                       FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                       MaxLines="3" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextFaintBrush}"
                       IsVisible="{DynamicResource HintsVisible}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <Border x:Name="EditorPanel" DockPanel.Dock="Right" Width="336"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <controls:PanelBox x:Name="EditorBox" Title="TILE EDITOR" FooterHeight="54">
          <controls:PanelBox.HeaderRightContent>
            <controls:SquircleBorder x:Name="VarianceToggle" Classes="emboss" Padding="9,4"
                                     Background="{StaticResource EmbossSurfaceBrush}" Cursor="Hand"
                                     ToolTip.Tip="Master switch for the ±σ bounds every tile draws">
              <TextBlock x:Name="VarianceToggleText" FontSize="{DynamicResource FontSize10}" LetterSpacing="1" />
            </controls:SquircleBorder>
          </controls:PanelBox.HeaderRightContent>
          <controls:PanelBox.InnerContent>
            <DockPanel>
              <controls:TerminalTabStrip x:Name="EditorTabs" DockPanel.Dock="Top" IsClosable="True" />
              <Border DockPanel.Dock="Top" Padding="12,8"
                      BorderBrush="{StaticResource RowSeparatorBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="VarianceNoteText" FontSize="{DynamicResource FontSize10}"
                           LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextFaintBrush}" />
              </Border>
              <ScrollViewer>
                <StackPanel x:Name="EditorBody" Margin="12,10" Spacing="10" />
              </ScrollViewer>
            </DockPanel>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock x:Name="EditorFooter" FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                       MaxLines="3" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextMutedBrush}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <dashboard:TileCanvas x:Name="Canvas" Background="{StaticResource BgDeepBrush}" />
    </DockPanel>
    <Canvas x:Name="GhostLayer" Background="Transparent" IsHitTestVisible="False" />
    <controls:HintPointerLayer ScreenIndex="2" />
  </Panel>
</UserControl>
