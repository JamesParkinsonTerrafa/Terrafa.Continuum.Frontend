<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:map="using:Terrafa.Continuum.Frontend.Controls.Map"
             x:Class="Terrafa.Continuum.Frontend.Views.SiteMapView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <Panel>
    <DockPanel>
      <controls:TerminalTopBar DockPanel.Dock="Top"
                               CommandText="MAP &lt;GO&gt;"
                               SubtitleText="SITE ALPHA · PHYSICAL EMBEDDING">
        <controls:TerminalTopBar.RightContent>
          <controls:FeedLiveBadge x:Name="FeedBadge" />
        </controls:TerminalTopBar.RightContent>
      </controls:TerminalTopBar>

      <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="4"
                                 HintText="pin any measure or dashboard figure onto the client's own site image — anchors are held against the image, not the screen" />

      <controls:TerminalStatusBar DockPanel.Dock="Bottom">
        <controls:TerminalStatusBar.LeftContent>
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="ZONES = ADJACENCY META-DESCRIPTORS" FontSize="{DynamicResource FontSize10}"
                       Foreground="{StaticResource TextFaintBrush}"
                       IsVisible="{DynamicResource HintsVisible}" />
            <TextBlock x:Name="PinCountText" FontSize="{DynamicResource FontSize10}"
                       Foreground="{StaticResource TextFaintBrush}" />
          </StackPanel>
        </controls:TerminalStatusBar.LeftContent>
        <controls:TerminalStatusBar.RightContent>
          <TextBlock x:Name="ImageBarText" FontSize="{DynamicResource FontSize10}" Foreground="{StaticResource TextFaintBrush}" />
        </controls:TerminalStatusBar.RightContent>
      </controls:TerminalStatusBar>

      <Border DockPanel.Dock="Left" Width="300"
              IsVisible="{DynamicResource BuilderPanelsVisible}"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Classes="sectionTitle" Text="SITE IMAGE" />
          </Border>
          <StackPanel DockPanel.Dock="Top" Margin="12,10" Spacing="8">
            <StackPanel x:Name="ImageActions" Orientation="Horizontal" Spacing="10" />
            <TextBlock x:Name="ImageStatusText" FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight14}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="Drop a PNG or JPEG straight onto the plan to do the same thing. Pins are held in image coordinates, so a replacement photo keeps the whole composition."
                       FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextFaintBrush}"
                       IsVisible="{DynamicResource HintsVisible}" />
          </StackPanel>

          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,1" Padding="12,8">
            <TextBlock Classes="sectionTitle" Text="LAYERS" />
          </Border>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel x:Name="LayerRows" Spacing="6" />
          </Border>

          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Classes="sectionTitle" Text="PIN A VALUE · DRAG ONTO PLAN" />
          </Border>

          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0" Padding="12,10"
                  IsVisible="{DynamicResource HintsVisible}">
            <TextBlock Text="Zones map to adjacency meta-descriptors — two tanks can touch in space without either owning the other."
                       FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextFaintBrush}" />
          </Border>
          <StackPanel x:Name="SelectedPinRows" DockPanel.Dock="Bottom" Margin="12,8" Spacing="7" />
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,1" Padding="12,8">
            <TextBlock x:Name="SelectedPinTitle" Classes="sectionTitle" Text="SELECTED PIN" />
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CatalogueList" Margin="0,8" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Panel>
        <map:SitePlanCanvas x:Name="Plan" />
      </Panel>
    </DockPanel>
    <Canvas x:Name="GhostLayer" IsHitTestVisible="False" />
  </Panel>
</UserControl>
