<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:charts="using:Terrafa.Continuum.Frontend.Controls.Charts"
             x:Class="Terrafa.Continuum.Frontend.Views.TransferFunctionView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <Panel>
    <DockPanel>
      <controls:TerminalTopBar DockPanel.Dock="Top"
                               CommandText="TFN"
                               SubtitleText="TRANSFER FUNCTION EDITOR">
        <controls:TerminalTopBar.RightContent>
          <TextBlock x:Name="TopBarStatus"
                     Text="editing: fig.draft_h — not yet committed to network" FontSize="{DynamicResource FontSize12}"
                     Foreground="{StaticResource TextMutedBrush}" />
        </controls:TerminalTopBar.RightContent>
      </controls:TerminalTopBar>

      <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="1"
                                 HintText="drag a library function onto a node to wrap it · right-click nodes for options · right-click a leaf to pin a constant" />

      <controls:TerminalStatusBar DockPanel.Dock="Bottom"
                                  IsVisible="{DynamicResource HintsVisible}">
        <controls:TerminalStatusBar.LeftContent>
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="COMPOSITION = FUNCTION TREE" FontSize="{DynamicResource FontSize10}"
                       Foreground="{StaticResource TextFaintBrush}" />
            <TextBlock Text="EACH INPUT PORT BRANCHES BELOW ITS FUNCTION" FontSize="{DynamicResource FontSize10}"
                       Foreground="{StaticResource TextFaintBrush}" />
          </StackPanel>
        </controls:TerminalStatusBar.LeftContent>
        <controls:TerminalStatusBar.RightContent>
          <TextBlock Text="σ PROPAGATION: PLACEHOLDER BAND — VARIANCE TRACE NOT YET WIRED"
                     FontSize="{DynamicResource FontSize10}" Foreground="{StaticResource TextFaintBrush}" />
        </controls:TerminalStatusBar.RightContent>
      </controls:TerminalStatusBar>

      <controls:DraftBar x:Name="Draft" DockPanel.Dock="Bottom" />

      <Border x:Name="LibraryPanel" DockPanel.Dock="Left" Width="250"
              IsVisible="{DynamicResource BuilderPanelsVisible}"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:PanelBox Title="FUNCTION LIBRARY" FooterHeight="54">
          <controls:PanelBox.InnerContent>
            <ScrollViewer>
              <StackPanel x:Name="LibraryList" Margin="12,10" Spacing="10" />
            </ScrollViewer>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock Text="Primitives are fixed. Right-click to create a composite. Estimators fit live on the NETWORK canvas."
                       FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight15}" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextFaintBrush}"
                       IsVisible="{DynamicResource HintsVisible}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <Border x:Name="StackColumn" DockPanel.Dock="Left" Width="470"
              IsVisible="{DynamicResource BuilderPanelsVisible}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:PanelBox x:Name="StackBox" Title="COMPOSITION" FooterHeight="54">
          <controls:PanelBox.HeaderRightContent>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <controls:SquircleBorder x:Name="NameField" Classes="emboss-press"
                                       Background="{StaticResource BgFieldBrush}">
                <TextBox x:Name="NameBox" Classes="field" Width="150"
                         Watermark="function name" />
              </controls:SquircleBorder>
              <controls:SquircleBorder x:Name="SaveButton" Classes="emboss-key" Padding="12,5"
                                       Background="{StaticResource AmberBrush}" Cursor="Hand">
                <TextBlock Text="SAVE ▸" FontSize="{DynamicResource FontSize10}" FontWeight="Bold" Foreground="Black" />
              </controls:SquircleBorder>
            </StackPanel>
          </controls:PanelBox.HeaderRightContent>
          <controls:PanelBox.InnerContent>
            <DockPanel>
              <controls:TerminalTabStrip x:Name="StackTabs" DockPanel.Dock="Top" IsClosable="True" />
              <ScrollViewer>
                <StackPanel x:Name="StackHost" Margin="18" HorizontalAlignment="Stretch" />
              </ScrollViewer>
            </DockPanel>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock x:Name="StackFooter" FontSize="{DynamicResource FontSize10}" LineHeight="{DynamicResource LineHeight16}" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextMutedBrush}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <controls:PanelBox x:Name="ResultPanel" Title="RESULT"
                         Hint="domain x ∈ [0.34, 3.2]" FooterHeight="54">
        <controls:PanelBox.InnerContent>
          <charts:LineChart x:Name="ResultChart" Margin="20" />
        </controls:PanelBox.InnerContent>
        <controls:PanelBox.FooterContent>
          <TextBlock x:Name="ResultFooter" FontSize="{DynamicResource FontSize10}"
                     Foreground="{StaticResource TextFaintBrush}" />
        </controls:PanelBox.FooterContent>
      </controls:PanelBox>
    </DockPanel>
    <controls:HintPointerLayer ScreenIndex="1" />
    <Canvas x:Name="Overlay" Background="Transparent" IsVisible="False" />
    <Panel x:Name="DialogHost" Background="{StaticResource ScrimBrush}" IsVisible="False" />
  </Panel>
</UserControl>
