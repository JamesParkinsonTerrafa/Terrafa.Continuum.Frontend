<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Terrafa.Continuum.Frontend.Views.MainWindow"
        Title="TERRAFA · CONTINUUM CORE"
        Width="1560" Height="1016"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">
  <Viewbox Stretch="Uniform">
    <ContentControl x:Name="ViewHost" Width="1560" Height="980" />
  </Viewbox>
</Window>
