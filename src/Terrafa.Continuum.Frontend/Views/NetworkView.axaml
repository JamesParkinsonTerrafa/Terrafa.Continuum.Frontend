<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:charts="using:Terrafa.Continuum.Frontend.Controls.Charts"
             x:Class="Terrafa.Continuum.Frontend.Views.NetworkView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <DockPanel>
    <controls:TerminalTopBar DockPanel.Dock="Top"
                             CommandText="NETW &lt;GO&gt;"
                             SubtitleText="MODEL NETWORK">
      <controls:TerminalTopBar.RightContent>
        <controls:FeedLiveBadge x:Name="FeedBadge" />
      </controls:TerminalTopBar.RightContent>
    </controls:TerminalTopBar>

    <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="0">
      <controls:TerminalTabStrip.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="AS-OF" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                     VerticalAlignment="Center" />
          <Border Background="{StaticResource BgFieldBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,3">
            <TextBlock x:Name="AsOfText" FontSize="11" Foreground="{StaticResource TextBrush}" />
          </Border>
          <TextBlock Text="filtration 𝓕ₜ — values shown use events ≤ t only" FontSize="11"
                     Foreground="{StaticResource TextFaintBrush}" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
      </controls:TerminalTabStrip.RightContent>
    </controls:TerminalTabStrip>

    <controls:TerminalStatusBar DockPanel.Dock="Bottom">
      <controls:TerminalStatusBar.LeftContent>
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock x:Name="EventCountText" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
          <TextBlock Text="STATE = FOLD(LOG) · REPLAY ✓" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
        </StackPanel>
      </controls:TerminalStatusBar.LeftContent>
      <controls:TerminalStatusBar.RightContent>
        <TextBlock Text="σ PROPAGATION: JACOBIAN · MC FALLBACK ARMED" FontSize="10"
                   Foreground="{StaticResource TextFaintBrush}" />
      </controls:TerminalStatusBar.RightContent>
    </controls:TerminalStatusBar>

    <controls:DraftBar DockPanel.Dock="Bottom"
                       CommandText="MAP (tank_01.level, tank_02.level) -&gt; fig.total_inventory AS sum"
                       ShowCursor="True">
      <controls:DraftBar.ChipContent>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <controls:Chip Text="PARSE ✓" Accent="green" />
          <controls:Chip Text="ν ≪ μ ✓" Accent="green" />
          <controls:Chip Text="C¹ ✓ linear" Accent="green" />
          <controls:Chip Text="σ_out 152 bbl" Accent="cyan" />
        </StackPanel>
      </controls:DraftBar.ChipContent>
    </controls:DraftBar>

    <Border DockPanel.Dock="Left" Width="272"
            Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <controls:PanelBox Title="DB MEASURES · SELECT TO PLACE">
        <controls:PanelBox.InnerContent>
          <StackPanel x:Name="MeasureList" Margin="12,10" Spacing="4" />
        </controls:PanelBox.InnerContent>
        <controls:PanelBox.FooterContent>
          <TextBlock Text="Only selected leaves enter the network. Selecting a leaf enlarges 𝒢 — every estimate it feeds sharpens."
                     FontSize="10" LineHeight="15" TextWrapping="Wrap"
                     Foreground="{StaticResource TextFaintBrush}" />
        </controls:PanelBox.FooterContent>
      </controls:PanelBox>
    </Border>

    <Border>
      <Border.Background>
        <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="70%" RadiusY="70%">
          <GradientStop Color="{StaticResource CanvasGlowInnerColor}" Offset="0" />
          <GradientStop Color="{StaticResource CanvasGlowOuterColor}" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
      <Canvas>
        <charts:EdgeLayer x:Name="Edges" Canvas.Left="0" Canvas.Top="0" Width="1287" Height="832" />

        <controls:NodeCard x:Name="Leaf1Card" Canvas.Left="70" Canvas.Top="118" Width="220"
                           Variant="Measure" TagText="MEASURE · LEAF" />
        <controls:NodeCard x:Name="Leaf2Card" Canvas.Left="70" Canvas.Top="258" Width="220"
                           Variant="Measure" TagText="MEASURE · LEAF" />
        <controls:NodeCard x:Name="Leaf3Card" Canvas.Left="70" Canvas.Top="418" Width="220"
                           Variant="Measure" TagText="MEASURE · LEAF" />
        <controls:NodeCard x:Name="Leaf4Card" Canvas.Left="70" Canvas.Top="558" Width="220"
                           Variant="Measure" TagText="MEASURE · LEAF" />

        <controls:NodeCard Canvas.Left="450" Canvas.Top="172" Width="250"
                           Variant="Transfer" TagText="TRANSFER · T1" TagRight="dμ/dν"
                           Title="sum(level_01, level_02)" TitleSize="12">
          <controls:NodeCard.ExtraContent>
            <TextBlock FontSize="9" LineHeight="14" Foreground="{StaticResource TextMutedBrush}">
              <Run Text="ν ≪ μ " /><Run Text="✓" Foreground="{StaticResource GreenBrush}" />
              <Run Text=" · C¹ (linear) " /><Run Text="✓" Foreground="{StaticResource GreenBrush}" />
              <LineBreak />
              <Run Text="σ_out = √(J Σ Jᵀ) — exact" />
            </TextBlock>
          </controls:NodeCard.ExtraContent>
        </controls:NodeCard>

        <controls:NodeCard Canvas.Left="450" Canvas.Top="468" Width="250"
                           Variant="Transfer" TagText="TRANSFER · T2" TagRight="dμ/dν"
                           Title="hazard λ₀(t)·exp(θᵀx)" TitleSize="12">
          <controls:NodeCard.ExtraContent>
            <TextBlock FontSize="9" LineHeight="14" Foreground="{StaticResource TextMutedBrush}">
              <Run Text="ν ≪ μ " /><Run Text="✓" Foreground="{StaticResource GreenBrush}" />
              <Run Text=" · " /><Run Text="NONLINEAR" Foreground="{StaticResource RedBrush}" />
              <Run Text=" — linearisation refused" />
              <LineBreak />
              <Run Text="⚠ branch auto-switched to MONTE-CARLO σ" Foreground="{StaticResource AmberBrush}" />
            </TextBlock>
          </controls:NodeCard.ExtraContent>
        </controls:NodeCard>

        <controls:NodeCard x:Name="FigInventoryCard" Canvas.Left="866" Canvas.Top="190" Width="270"
                           Variant="Figure" TagText="DASHBOARD FIG"
                           Title="fig.total_inventory" ValueSize="16"
                           Note="σ composed up the tree · pinned to DASH &amp; MAP" />

        <controls:NodeCard x:Name="FigExpiryCard" Canvas.Left="866" Canvas.Top="472" Width="270"
                           Variant="Provisional" TagText="DASHBOARD FIG · PROVISIONAL" TagRight="L4"
                           Title="fig.expiry_risk" ValueSize="16"
                           Note="⚠ under-determined — frailty Z not identifiable from these leaves. Drawn provisional, not asserted. Add prior or leaf to pin down." />

        <Border Canvas.Right="16" Canvas.Top="14"
                Background="{StaticResource CanvasPanelBackdropBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="12,8">
          <StackPanel Spacing="5" x:Name="LegendPanel" />
        </Border>
      </Canvas>
    </Border>
  </DockPanel>
</UserControl>
