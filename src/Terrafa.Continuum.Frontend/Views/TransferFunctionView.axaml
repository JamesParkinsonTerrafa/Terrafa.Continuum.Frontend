<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:charts="using:Terrafa.Continuum.Frontend.Controls.Charts"
             x:Class="Terrafa.Continuum.Frontend.Views.TransferFunctionView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <Panel>
    <DockPanel>
      <controls:TerminalTopBar DockPanel.Dock="Top"
                               CommandText="TFN &lt;GO&gt;"
                               SubtitleText="TRANSFER FUNCTION EDITOR">
        <controls:TerminalTopBar.RightContent>
          <TextBlock x:Name="TopBarStatus"
                     Text="editing: fig.draft_h — not yet committed to network" FontSize="12"
                     Foreground="{StaticResource TextMutedBrush}" />
        </controls:TerminalTopBar.RightContent>
      </controls:TerminalTopBar>

      <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="1"
                                 HintText="click a library function to append it · drag it into the stack to insert · drag stages vertically to reorder" />

      <controls:TerminalStatusBar DockPanel.Dock="Bottom">
        <controls:TerminalStatusBar.LeftContent>
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="COMPOSITION = ORDERED PRIMITIVE CHAIN" FontSize="10"
                       Foreground="{StaticResource TextFaintBrush}" />
            <TextBlock Text="STAGES APPLY TOP-TO-BOTTOM" FontSize="10"
                       Foreground="{StaticResource TextFaintBrush}" />
          </StackPanel>
        </controls:TerminalStatusBar.LeftContent>
        <controls:TerminalStatusBar.RightContent>
          <TextBlock Text="σ PROPAGATION: PLACEHOLDER BAND — VARIANCE TRACE NOT YET WIRED"
                     FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
        </controls:TerminalStatusBar.RightContent>
      </controls:TerminalStatusBar>

      <controls:DraftBar x:Name="Draft" DockPanel.Dock="Bottom" />

      <Border x:Name="LibraryPanel" DockPanel.Dock="Left" Width="250"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:PanelBox Title="FUNCTION LIBRARY">
          <controls:PanelBox.InnerContent>
            <ScrollViewer>
              <StackPanel x:Name="LibraryList" Margin="12,10" Spacing="10" />
            </ScrollViewer>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock Text="Primitives are fixed — they cannot be edited or deleted. Right-click the library to create a new composite function."
                       FontSize="10" LineHeight="15" TextWrapping="Wrap"
                       Foreground="{StaticResource TextFaintBrush}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <Border x:Name="StackColumn" DockPanel.Dock="Left" Width="400"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:PanelBox x:Name="StackBox" Title="COMPOSITION STACK" Hint="draft: fig.draft_h">
          <controls:PanelBox.HeaderRightContent>
            <Border x:Name="SaveButton" Background="{StaticResource AmberBrush}"
                    Padding="10,3" Cursor="Hand">
              <TextBlock Text="SAVE ▸" FontSize="10" FontWeight="Bold" Foreground="Black" />
            </Border>
          </controls:PanelBox.HeaderRightContent>
          <controls:PanelBox.InnerContent>
            <ScrollViewer>
              <StackPanel x:Name="StackHost" Margin="18" HorizontalAlignment="Stretch" />
            </ScrollViewer>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock x:Name="StackFooter" FontSize="10" LineHeight="16" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <controls:PanelBox x:Name="ResultPanel" Title="RESULT"
                         Hint="domain x ∈ [0.34, 3.2]">
        <controls:PanelBox.InnerContent>
          <charts:LineChart x:Name="ResultChart" Margin="20" />
        </controls:PanelBox.InnerContent>
        <controls:PanelBox.FooterContent>
          <TextBlock x:Name="ResultFooter" FontSize="10"
                     Foreground="{StaticResource TextFaintBrush}" />
        </controls:PanelBox.FooterContent>
      </controls:PanelBox>
    </DockPanel>
    <Canvas x:Name="Overlay" Background="Transparent" IsVisible="False" />
  </Panel>
</UserControl>
