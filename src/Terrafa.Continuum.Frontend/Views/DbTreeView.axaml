<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Terrafa.Continuum.Frontend.Controls"
             xmlns:charts="using:Terrafa.Continuum.Frontend.Controls.Charts"
             x:Class="Terrafa.Continuum.Frontend.Views.DbTreeView"
             Width="1560" Height="980"
             Background="{StaticResource BgDeepBrush}">
  <Panel>
    <DockPanel>
      <controls:TerminalTopBar DockPanel.Dock="Top"
                               CommandText="TREE &lt;GO&gt;"
                               SubtitleText="SCHEMA · MOUNTED SUBTREES">
        <controls:TerminalTopBar.RightContent>
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border Background="{StaticResource AmberBrush}" Padding="12,4">
              <TextBlock Text="↻ REFRESH SCHEMA &lt;GO&gt;" FontSize="11" FontWeight="Bold"
                         Foreground="Black" />
            </Border>
            <TextBlock Text="last 14:02:11" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </controls:TerminalTopBar.RightContent>
      </controls:TerminalTopBar>

      <controls:TerminalTabStrip x:Name="Tabs" DockPanel.Dock="Top" ActiveIndex="3"
                                 HintBrush="{StaticResource GreenBrush}" />

      <controls:TerminalStatusBar DockPanel.Dock="Bottom">
        <controls:TerminalStatusBar.LeftContent>
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock x:Name="ShapeText" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
            <TextBlock Text="PER-SUBTREE FILTRATION 𝓕ₜ — JOINS INHERIT THE COARSEST" FontSize="10"
                       Foreground="{StaticResource TextFaintBrush}" />
          </StackPanel>
        </controls:TerminalStatusBar.LeftContent>
        <controls:TerminalStatusBar.RightContent>
          <TextBlock Text="CONTAINMENT NEVER CROSSES A DATASET BOUNDARY" FontSize="10"
                     Foreground="{StaticResource TextFaintBrush}" />
        </controls:TerminalStatusBar.RightContent>
      </controls:TerminalStatusBar>

      <Border DockPanel.Dock="Left" Width="248"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:PanelBox Title="SUBTREES · SHOW / HIDE">
          <controls:PanelBox.InnerContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,4,0,10">
                <StackPanel x:Name="SubtreeToggles" />
                <TextBlock Text="CROSS-SUBTREE LINKS" FontSize="10" LetterSpacing="1"
                           Margin="14,14,14,4" Foreground="{StaticResource AmberBrush}" />
                <StackPanel x:Name="LinkToggles" />
                <StackPanel x:Name="LinkList" />
              </StackPanel>
            </ScrollViewer>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <TextBlock Text="Bands are subtrees. No edge may make one dataset a child of another — the contracts would no longer hold."
                       FontSize="10" LineHeight="15" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <Border DockPanel.Dock="Right" Width="360"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <controls:PanelBox Title="EVENT LOG · ALL SUBTREES" Hint="source of truth">
          <controls:PanelBox.InnerContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="EventRows" />
            </ScrollViewer>
          </controls:PanelBox.InnerContent>
          <controls:PanelBox.FooterContent>
            <StackPanel Spacing="6">
              <TextBlock Text="Mounts, binds and links are all just events — a subtree can be removed by replaying without its mount."
                         FontSize="10" LineHeight="16" TextWrapping="Wrap"
                         Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock x:Name="ReplayText" FontSize="10" Foreground="{StaticResource GreenBrush}" />
            </StackPanel>
          </controls:PanelBox.FooterContent>
        </controls:PanelBox>
      </Border>

      <Border>
        <Border.Background>
          <RadialGradientBrush Center="45%,35%" GradientOrigin="45%,35%" RadiusX="70%" RadiusY="70%">
            <GradientStop Color="{StaticResource CanvasGlowInnerColor}" Offset="0" />
            <GradientStop Color="{StaticResource CanvasGlowOuterColor}" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
        <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="TreeCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
              <charts:EdgeLayer x:Name="Edges" Canvas.Left="0" Canvas.Top="0" />
            </Canvas>
          </ScrollViewer>

          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"
                  Background="{StaticResource CanvasPanelBackdropBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  Padding="12,8" IsHitTestVisible="False">
            <StackPanel Spacing="5" x:Name="LegendPanel" />
          </Border>
        </Panel>
      </Border>
    </DockPanel>

    <controls:ContextMenuLayer x:Name="MenuLayer" />
    <controls:OverlayDialog x:Name="Dialog" />
  </Panel>
</UserControl>
